server {
    listen 127.0.0.1:8080;
    root /;
    index index.html;
    client_max_body_size 1m;
    location / {
        allowed_methods GET POST;
        autoindexing on;
    }
    location /cgi-bin {
        allowed_methods GET POST;
        cgi_extension .py .php;
        cgi_path /usr/bin/python3 /usr/bin/php;
    }
    location /uploads {
        allowed_methods GET POST DELETE;
        autoindexing on;
    }
    error_page 404 /404.html;
}

